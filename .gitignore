# ── Data & weights (IP protection) ───────────────────────────────────
data/raw/
data/processed/
data/annotations/
weights/
*.pt
*.pth
*.onnx

# ── Experiment outputs ────────────────────────────────────────────────
experiments/*/results.json
experiments/*/logs/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# ── LaTeX build artifacts ────────────────────────────────────────────
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/main.pdf      # PDF is a build artifact; keep .tex in version control

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets ───────────────────────────────────────────────────────────
.env
secrets.yaml
