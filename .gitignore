# ── Data & weights (IP protection) ───────────────────────────────────
data/raw/
data/processed/
data/annotations/
weights/
*.pt
*.pth
*.onnx

# ── Experiment outputs ────────────────────────────────────────────────
experiments/*/results.json
experiments/*/logs/
# Footage-derived artifacts (IP protection): rendered clips are real
# imagery; detections/track dumps are large per-run binaries.
experiments/**/*.mp4
experiments/**/detections*.npz
experiments/**/tracks_*.json

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# ── Paper (local only, not version controlled) ───────────────────────
paper/

# ── Third-party sources cloned locally (ByteTrack, etc.) ─────────────
lib/

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets ───────────────────────────────────────────────────────────
.env
secrets.yaml
# real credentials; tele_api.example.yaml stays committed as a template
configs/tele_api.yaml

# ── Local working notes & tooling (not shared) ───────────────────────
CLAUDE.md
SCOPE.md
.claude/
